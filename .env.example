# ============================================================================
# SmartPrice — примерна конфигурация. Копирай на .env и попълни стойностите.
# ============================================================================

# --- PostgreSQL (собствена база, не Supabase) ---
POSTGRES_DB=smartprice
POSTGRES_USER=smartprice
POSTGRES_PASSWORD=смени-ме-с-силна-парола
POSTGRES_HOST_PORT=5433

# --- API ---
API_HOST_PORT=4000
PUBLIC_BASE_URL=http://localhost:4000
# Поне 24 символа. Генерирай: openssl rand -base64 48
JWT_SECRET=смени-ме-със-случаен-низ-поне-24-символа
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
MAX_UPLOAD_MB=12
# Позволени origins за приложението (за Expo web / dev: *)
CORS_ORIGINS=*

# --- Реален OCR през OpenRouter (vision модел) ---
# Без ключ endpoint-ът честно връща 503 вместо да измисля бележки.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OCR_MODEL=google/gemini-2.5-flash

# --- Stripe (реални плащания) ---
# Без ключ endpoint-ът връща 503 вместо да фалшифицира успех.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=eur

# --- Имейли (кодове за потвърждение на регистрация и забравена парола) --------
# Resend API ключ. Без него регистрацията работи, но не може да изпраща кодове
# и сървърът честно връща 503 вместо да се преструва, че е пратил имейл.
RESEND_API_KEY=
# Подателят. Домейнът трябва да е потвърден в Resend.
MAIL_FROM=SmartPrice <info@human.lookthis.online>
# Колко минути е валиден един код
VERIFICATION_CODE_TTL_MIN=15
# Колко кода може да поиска един имейл за 1 час
VERIFICATION_MAX_PER_HOUR=5
# Колко грешни опита се толерират, преди кодът да се обезсили
VERIFICATION_MAX_ATTEMPTS=5

# --- Демо данни при празна база ---
# В продукция го сложи false — иначе празна база се пълни с примерни оферти.
SEED_DEMO_DATA=true

# ============================================================================
# КЪДЕ ЖИВЕЯТ СНИМКИТЕ
# ============================================================================
# local (по подразбиране) = на диска на сървъра.
# s3 = в Cloudflare R2 (или MinIO / AWS S3 / Backblaze).
#
# Защо да го смениш: снимките са най-големият трафик. На диск всяко отваряне
# на оферта минава през сървъра и яде порта. В R2 зад Cloudflare се кешират
# на ръба и сървърът почти не ги сервира.
#
# Стъпки за Cloudflare R2:
#   1. dash.cloudflare.com → R2 → Create bucket (напр. smartprice)
#   2. Bucket → Settings → Public access → свържи собствен домейн
#      (напр. img.smart.lookthis.online) ИЛИ ползвай r2.dev адреса
#   3. R2 → Manage API Tokens → Create token (Object Read & Write)
#   4. Попълни долу и сложи STORAGE_DRIVER=s3, после:
#      docker compose up -d api
#
# Старите снимки продължават да се сервират от диска — нищо не се чупи.
# За да преместиш и тях в R2, виж scripts/migrate-uploads-to-s3.sh
STORAGE_DRIVER=local
# За R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ENDPOINT=
# R2 иска да има стойност, но не я ползва. За AWS — истинският регион.
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Публичният адрес, на който се виждат файловете (без наклонена черта накрая)
S3_PUBLIC_BASE_URL=
# Префикс (папка) в кофата
S3_KEY_PREFIX=uploads
# R2 работи с виртуален хост → false. MinIO иска path-style → true.
S3_FORCE_PATH_STYLE=false

# ============================================================================
# За мобилното приложение (Expo) — създай .env в основната папка:
# EXPO_PUBLIC_API_URL=http://<IP-на-този-компютър>:4000
# EXPO_PUBLIC_DEEP_LINK_SCHEME=smartprice
# ============================================================================
